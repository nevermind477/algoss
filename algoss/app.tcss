Screen {
    background: #000000;
    color: #ffffff;
}

#body {
    height: 1fr;
    width: 100%;
}

#side {
    width: 38;
    height: 100%;
    padding: 0 1;
    background: #0d0d0d;
    border-right: solid #333333;
    overflow-y: auto;
}

#main {
    width: 1fr;
    height: 100%;
    background: #000000;
    padding: 0 1;
}

.cap {
    color: #888888;
    margin-top: 1;
    text-style: bold;
}

#side Select {
    width: 100%;
    background: #141414;
    border: tall #333333;
    color: #ffffff;
}

#side Select:focus {
    border: tall #ffd700;
}

#side Input {
    width: 100%;
    height: 3;
    padding: 0 1;
    background: #141414;
    border: tall #333333;
    color: #ffffff;
}

#side Input:focus {
    border: tall #ffd700;
}

#param_buttons {
    height: 3;
    width: 100%;
    margin-top: 1;
}

#btn_rand {
    width: 1fr;
    height: 3;
    min-width: 8;
    margin-right: 1;
    background: #141414;
    border: tall #333333;
    color: #ffffff;
}

#btn_apply {
    width: 1fr;
    height: 3;
    min-width: 8;
    background: #141414;
    border: tall #333333;
    color: #ffffff;
}

#side Button {
    width: 100%;
    height: 3;
    margin-top: 1;
    background: #141414;
    border: tall #333333;
    color: #ffffff;
}

#side Button:hover {
    border: tall #ffd700;
}

#side Button.-active {
    background: #222222;
    color: #ffd700;
}

#play {
    color: #ffd700;
    text-style: bold;
    border: tall #ffd700;
}

#speed {
    height: 1;
    width: 1fr;
    margin-top: 1;
    margin-bottom: 1;
}

#speed:focus {
    background: #1a1a1a;
}

#canvas {
    height: 11;
    width: 100%;
    margin-top: 0;
}

#state {
    height: 4;
    width: 100%;
    margin-top: 1;
}

#trace {
    height: 1fr;
    min-height: 5;
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
}

Footer {
    background: #0d0d0d;
    color: #888888;
}

Footer > .footer--highlight {
    background: #ffd700;
    color: #000000;
}

Footer > .footer--key {
    color: #ffd700;
}
