Screen {
    background: #000000;
    color: #ffffff;
    overflow: hidden;
}

#body {
    height: 1fr;
    width: 100%;
}

#side {
    width: 38;
    height: 100%;
    padding: 0 1;
    background: #080808;
    border-right: solid #2a2a2a;
    overflow-y: auto;
    overflow-x: hidden;
}

#main {
    width: 1fr;
    height: 100%;
    background: #000000;
    padding: 0 1;
}

#logo {
    width: 100%;
    height: auto;
    margin-top: 0;
    margin-bottom: 1;
    text-wrap: nowrap;
    overflow: hidden;
}

#cat_bar {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

#algo_list {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

#keymap {
    width: 100%;
    height: 11;
    margin-bottom: 1;
}

#canvas {
    height: 1fr;
    min-height: 9;
    width: 100%;
    margin-top: 0;
}

#numbers_box {
    height: 3;
    width: 100%;
    border: solid #444444;
    background: #0a0a0a;
    padding: 0 1;
    margin-top: 1;
}

.cfg_lbl {
    height: 1;
    color: #888888;
    text-style: bold;
    margin-right: 1;
}

.cfg_inp {
    height: 1;
    border: none;
    background: #161616;
    color: #ffffff;
    padding: 0 1;
    width: 1fr;
}

.cfg_inp:focus {
    background: #282828;
    color: #ffffff;
    text-style: bold;
}

.cfg_inp_sm {
    height: 1;
    border: none;
    background: #161616;
    color: #ffffff;
    padding: 0 1;
    width: 12;
}

.cfg_inp_sm:focus {
    background: #282828;
    color: #ffffff;
    text-style: bold;
}

.cfg_btn {
    height: 1;
    min-width: 7;
    border: none;
    background: #222222;
    color: #cccccc;
    margin-left: 1;
}

.cfg_btn:hover {
    background: #ffffff;
    color: #000000;
}

.hidden {
    display: none;
}

#state {
    height: 4;
    width: 100%;
    margin-top: 1;
}

#trace {
    height: 5;
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
}

#status_bar {
    width: 100%;
    height: 1;
    background: #222222;
    color: #ffffff;
}
