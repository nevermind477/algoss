Screen {
    background: #000000;
    color: #ffffff;
}

#body {
    height: 1fr;
    width: 100%;
}

#side {
    width: 40;
    height: 100%;
    padding: 0 1;
    background: #0a0a0a;
    border-right: solid #2a2a2a;
    overflow-y: auto;
}

#main {
    width: 1fr;
    height: 100%;
    background: #000000;
    padding: 0 1;
}

#logo {
    color: #ffffff;
    text-style: bold;
    height: 5;
    margin-top: 0;
    margin-bottom: 0;
}

.sec_title {
    color: #777777;
    margin-top: 1;
    text-style: bold;
}

#cat_bar {
    height: 3;
    width: 100%;
    margin-top: 0;
}

.cat_btn {
    width: 1fr;
    height: 3;
    min-width: 6;
    margin-right: 1;
    background: #111111;
    border: tall #333333;
    color: #777777;
}

.cat_btn:hover {
    border: tall #ffffff;
    color: #ffffff;
}

.cat_btn.-active {
    background: #242424;
    border: tall #ffffff;
    color: #ffffff;
    text-style: bold;
}

#algo_list {
    height: 7;
    width: 100%;
    background: #111111;
    border: tall #333333;
    color: #888888;
    margin-top: 0;
    padding: 0;
}

#algo_list:focus {
    border: tall #ffffff;
}

#algo_list > .option-list--option-highlighted {
    background: #242424;
    color: #ffffff;
    text-style: bold;
}

#side Input {
    width: 100%;
    height: 3;
    padding: 0 1;
    background: #111111;
    border: tall #333333;
    color: #ffffff;
}

#side Input:focus {
    border: tall #ffffff;
}

#param_actions {
    height: 3;
    width: 100%;
    margin-top: 1;
}

#btn_rand {
    width: 1fr;
    height: 3;
    min-width: 6;
    margin-right: 1;
    background: #111111;
    border: tall #333333;
    color: #cccccc;
}

#btn_apply {
    width: 1fr;
    height: 3;
    min-width: 6;
    background: #111111;
    border: tall #333333;
    color: #cccccc;
}

#play {
    width: 100%;
    height: 3;
    margin-top: 0;
    background: #111111;
    border: tall #ffffff;
    color: #ffffff;
    text-style: bold;
}

#play:hover {
    background: #242424;
}

#step_actions {
    height: 3;
    width: 100%;
    margin-top: 1;
}

#step {
    width: 1fr;
    height: 3;
    min-width: 6;
    margin-right: 1;
    background: #111111;
    border: tall #333333;
    color: #cccccc;
}

#reset {
    width: 1fr;
    height: 3;
    min-width: 6;
    background: #111111;
    border: tall #333333;
    color: #cccccc;
}

#step:hover, #reset:hover, #btn_rand:hover, #btn_apply:hover {
    border: tall #ffffff;
    color: #ffffff;
}

#speed {
    height: 1;
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
}

#speed:focus {
    background: #1a1a1a;
}

#canvas {
    height: 50%;
    min-height: 12;
    width: 100%;
    margin-top: 0;
}

#state {
    height: 4;
    width: 100%;
    margin-top: 1;
}

#trace {
    height: 1fr;
    min-height: 5;
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
}

Footer {
    background: #0a0a0a;
    color: #777777;
}

Footer > .footer--highlight {
    background: #ffffff;
    color: #000000;
}

Footer > .footer--key {
    color: #ffffff;
}
