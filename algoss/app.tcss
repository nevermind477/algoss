Screen {
    background: #000000;
    color: #ffffff;
    overflow: hidden;
}

#body {
    height: 1fr;
    width: 100%;
}

#side {
    width: 42;
    height: 100%;
    padding: 0 1;
    background: #080808;
    border-right: solid #2a2a2a;
    overflow-y: auto;
    overflow-x: hidden;
}

#main {
    width: 1fr;
    height: 100%;
    background: #000000;
    padding: 0 1;
}

#logo {
    width: 100%;
    height: auto;
    margin-top: 0;
    margin-bottom: 1;
    text-wrap: nowrap;
    overflow: hidden;
}

#cat_bar {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

#algo_list {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

#params_view {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

#input_p1 {
    width: 100%;
    height: 3;
    background: #111111;
    border: tall #ffffff;
    color: #ffffff;
    margin-bottom: 1;
}

#input_p2 {
    width: 100%;
    height: 3;
    background: #111111;
    border: tall #888888;
    color: #ffffff;
    margin-bottom: 1;
}

.hidden {
    display: none;
}

#keymap {
    width: 100%;
    height: 6;
    margin-bottom: 1;
}

#status_bar {
    width: 100%;
    height: 1;
    background: #222222;
    color: #ffffff;
}

#canvas {
    height: 50%;
    min-height: 11;
    width: 100%;
    margin-top: 0;
}

#state {
    height: 4;
    width: 100%;
    margin-top: 1;
}

#trace {
    height: 1fr;
    min-height: 5;
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
}
